<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         NOTE: the app itself also needs INTERNET at runtime (X links and
         Giphy), and that declaration lives in the MAIN manifest. Do not assume
         this one covers it; it does not apply to release.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- There is deliberately NO usesCleartextTraffic here any more. It existed
         only so a locally-run extractor service could be reached over
         "adb reverse" while the phone was tethered to a dev machine by USB.
         That arrangement is gone: X posts are resolved by the app itself over
         HTTPS, so nothing in this project speaks cleartext in any build type.
         Re-adding it would widen what a debug build may do, for nothing.
    -->
</manifest>
