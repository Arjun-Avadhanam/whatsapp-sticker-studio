<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Sticker Studio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode is singleTask, NOT Flutter's default singleTop. A share
             into a backgrounded app arrives from another task, and singleTop only
             reuses an activity already on top of the *current* task — so Android
             spawned a fresh instance (and a fresh Flutter engine) for every
             share. The warm getMediaStream listener in the already-running engine
             then never fired, dropping the share silently. Caught on device
             2026-08-01 by the SOURCE 5 probe. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Share-into-app: registers us as an OS share target so a shared
                 screenshot, screen recording or gallery item opens straight into
                 the Maker. This rides the OS share sheet, not WhatsApp's sticker
                 API, so it keeps working regardless of what WhatsApp changes.

                 SEND and SEND_MULTIPLE are separate filters because a single
                 filter matching both actions would also claim shares we cannot
                 handle. image/* and video/* only — never */*, which would put us
                 in the share sheet for PDFs and text we have no use for. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
        </activity>
        <!-- Serves staged sticker packs to WhatsApp. The authority is derived from the
             package name in StickerContentProvider.onCreate(), so the two cannot drift.
             exported=true is required (WhatsApp is a separate app), and the read permission
             restricts it to WhatsApp rather than every app on the device. -->
        <provider
            android:name=".StickerContentProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11+ hides other apps by default. Without declaring WhatsApp here the
             ENABLE_STICKER_PACK intent resolves to nothing and throws ActivityNotFoundException
             even when WhatsApp is installed. Both consumer and Business are listed, since a
             user may have either. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>
